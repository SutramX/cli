{
  "name": "@sutramx/cli",
  "version": "0.1.0",
  "description": "SutramX command line: manage uptime monitors and keep them in code with sutramx.yml (plan / diff / apply).",
  "license": "MIT",
  "author": "SutramX",
  "homepage": "https://github.com/sutramx/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sutramx/cli.git"
  },
  "bugs": {
    "url": "https://github.com/sutramx/cli/issues"
  },
  "keywords": [
    "sutramx",
    "uptime",
    "uptime-monitoring",
    "monitoring",
    "monitors-as-code",
    "status-page",
    "incidents",
    "cli",
    "devops",
    "sre"
  ],
  "type": "module",
  "bin": {
    "sutramx": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check-version": "node scripts/check-version.mjs",
    "prepublishOnly": "npm run check-version && npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
